{
  "jf": {
    "color": {
      "white": {
        "$type": "color",
        "$value": "#fff"
      },
      "black": {
        "$type": "color",
        "$value": "#000"
      },
      "alpha": {
        "white": {
          "100": {
            "$type": "color",
            "$value": "oklch( {jf.color.white} /{jf.opacity.1})"
          },
          "200": {
            "$extensions": {
              "studio.tokens": {
                "modify": {
                  "type": "alpha",
                  "value": "{jf.opacity.2}",
                  "space": "srgb"
                }
              }
            },
            "$type": "color",
            "$value": "{jf.color.white}"
          },
          "300": {
            "$type": "color",
            "$value": "oklch(1 0 0/30%)"
          },
          "400": {
            "$type": "color",
            "$value": "oklch(1 0 0/40%)"
          },
          "500": {
            "$type": "color",
            "$value": "oklch(1 0 0/50%)"
          },
          "600": {
            "$type": "color",
            "$value": "oklch(1 0 0/60%)"
          },
          "700": {
            "$type": "color",
            "$value": "oklch(1 0 0/70%)"
          },
          "800": {
            "$type": "color",
            "$value": "oklch(1 0 0/80%)"
          },
          "900": {
            "$type": "color",
            "$value": "oklch(1 0 0/{jf.opacity.9})"
          }
        },
        "black": {
          "100": {
            "$type": "color",
            "$value": "oklch(0 0 0/10%)"
          },
          "200": {
            "$type": "color",
            "$value": "oklch(0 0 0/20%)"
          },
          "300": {
            "$type": "color",
            "$value": "oklch(0 0 0/30%)"
          },
          "400": {
            "$type": "color",
            "$value": "oklch(0 0 0/40%)"
          },
          "500": {
            "$type": "color",
            "$value": "oklch(0 0 0/50%)"
          },
          "600": {
            "$type": "color",
            "$value": "oklch(0 0 0/60%)"
          },
          "700": {
            "$type": "color",
            "$value": "oklch(0 0 0/70%)"
          },
          "800": {
            "$type": "color",
            "$value": "oklch(0 0 0/80%)"
          },
          "900": {
            "$type": "color",
            "$value": "oklch(0 0 0/90%)"
          }
        }
      }
    },
    "opacity": {
      "0": {
        "$type": "opacity",
        "$value": "0"
      },
      "1": {
        "$type": "opacity",
        "$value": "0.1"
      },
      "2": {
        "$type": "opacity",
        "$value": "0.2"
      },
      "3": {
        "$type": "opacity",
        "$value": "0.3"
      },
      "4": {
        "$type": "opacity",
        "$value": "0.4"
      },
      "5": {
        "$type": "opacity",
        "$value": "0.5"
      },
      "6": {
        "$type": "opacity",
        "$value": "0.6"
      },
      "7": {
        "$type": "opacity",
        "$value": "0.7"
      },
      "8": {
        "$type": "opacity",
        "$value": "0.8"
      },
      "9": {
        "$type": "opacity",
        "$value": "0.9"
      }
    },
    "size": {
      "1": {
        "$type": "dimension",
        "$value": "2px"
      },
      "2": {
        "$type": "dimension",
        "$value": "{jf.size.1} *2"
      },
      "3": {
        "$type": "dimension",
        "$value": "{jf.size.1} *3"
      },
      "4": {
        "$type": "dimension",
        "$value": "{jf.size.1} *4"
      },
      "full": {
        "$type": "other",
        "$value": "100%"
      },
      "half": {
        "$type": "other",
        "$value": "50%"
      },
      "third": {
        "$type": "other",
        "$value": "33%"
      },
      "quarter": {
        "$type": "other",
        "$value": "25%"
      }
    },
    "fraction": {
      "1": {
        "$type": "other",
        "$value": "1fr"
      },
      "2": {
        "$type": "other",
        "$value": "2fr"
      },
      "3": {
        "$type": "other",
        "$value": "3fr"
      },
      "4": {
        "$type": "other",
        "$value": "4fr"
      }
    },
    "font-family": {
      "sans": {
        "$type": "fontFamilies",
        "$value": "Google Sans"
      },
      "serif": {
        "$type": "fontFamilies",
        "$value": "Newsreader"
      },
      "mono": {
        "$type": "fontFamilies",
        "$value": "Fira Code"
      },
      "icon": {
        "$type": "fontFamilies",
        "$value": "Font Awesome 7 Free"
      },
      "decoration": {
        "$type": "fontFamilies",
        "$value": "Ezra"
      }
    },
    "font-size": {
      "xs": {
        "$type": "fontSizes",
        "$value": "0.75rem"
      },
      "sm": {
        "$type": "fontSizes",
        "$value": "0.875rem"
      },
      "md": {
        "$type": "fontSizes",
        "$value": "1rem"
      },
      "lg": {
        "$type": "fontSizes",
        "$value": "1.125rem"
      },
      "xl": {
        "$type": "fontSizes",
        "$value": "1.25rem"
      },
      "2xl": {
        "$type": "text",
        "$value": "clamp(1.1375rem, 1.1073rem + 0.3523vw, 1.5rem)"
      }
    },
    "font-weight": {
      "300": {
        "$type": "fontWeights",
        "$value": "light"
      },
      "400": {
        "$type": "fontWeights",
        "$value": "regular"
      },
      "500": {
        "$type": "fontWeights",
        "$value": "medium"
      }
    },
    "letter-spacing": {
      "compact": {
        "$type": "letterSpacing",
        "$value": "-0.05rem"
      }
    },
    "line-height": {
      "sm": {
        "$type": "lineHeights",
        "$value": "120%"
      }
    },
    "border": {
      "width": {
        "1": {
          "$type": "borderWidth",
          "$value": "{jf.size.1}"
        },
        "3": {
          "$type": "borderWidth",
          "$value": "{jf.size.1}*3"
        },
        "4": {
          "$type": "borderWidth",
          "$value": "{jf.size.1}*4"
        },
        "0-5": {
          "$type": "borderWidth",
          "$value": "{jf.size.1}*0.5"
        }
      },
      "radius": {
        "0": {
          "$type": "borderRadius",
          "$value": "0"
        },
        "2": {
          "$type": "borderRadius",
          "$value": "{jf.size.1}"
        },
        "3": {
          "$type": "borderRadius",
          "$value": "{jf.size.1}*3"
        },
        "4": {
          "$type": "borderRadius",
          "$value": "{jf.size.1}*4"
        },
        "6": {
          "$type": "borderRadius",
          "$value": "{jf.size.1}*6"
        },
        "12": {
          "$type": "borderRadius",
          "$value": "{jf.size.1}*12"
        },
        "circle": {
          "$type": "other",
          "$value": "50%"
        }
      }
    },
    "angle": {
      "1": {
        "$type": "other",
        "$value": "0"
      },
      "2": {
        "$type": "other",
        "$value": "5"
      },
      "3": {
        "$type": "other",
        "$value": "15"
      },
      "4": {
        "$type": "other",
        "$value": "45"
      }
    },
    "duration": {
      "instant": {
        "$type": "duration",
        "value": {
          "unit": "ms",
          "$value": 0
        }
      },
      "breaf": {
        "$type": "duration",
        "value": {
          "unit": "ms",
          "$value": 100
        }
      },
      "short": {
        "$type": "duration",
        "value": {
          "unit": "ms",
          "$value": 150
        }
      },
      "medium": {
        "$type": "duration",
        "value": {
          "unit": "ms",
          "$value": 250
        }
      }
    },
    "motion": {
      "linear": {
        "$type": "other",
        "$value": "linear"
      },
      "accelerate": {
        "$type": "cubicBezier",
        "$value": [
          0.3,
          0,
          1,
          1
        ]
      },
      "deccelerate": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0,
          1
        ]
      },
      "balaced": {
        "$type": "cubicBezier",
        "$value": [
          0.4,
          0,
          0.2,
          1
        ]
      }
    },
    "scale": {
      "0": {
        "$type": "number",
        "$value": 0
      },
      "95": {
        "$type": "number",
        "$value": 0.95
      },
      "100": {
        "$type": "number",
        "$value": 1
      },
      "105": {
        "$type": "number",
        "$value": 1.05
      }
    }
  }
}