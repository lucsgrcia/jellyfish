{
  "servers": {
    "coda": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "coda-mcp@latest"],
      "env": {
        "API_KEY": "${input:coda-api-key}"
      }
    }
  },
  "inputs": [
    {
      "id": "coda-api-key",
      "type": "promptString",
      "description": "Coda API key",
      "password": true
    }
  ]
}
